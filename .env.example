# ==========================================
# Guardrail-CI Environment Configuration
# ==========================================

# GitHub Configuration
# Use a fine-grained Personal Access Token (PAT) with read-only permissions for Phase 1.
GITHUB_TOKEN=github_pat_example_token_replace_with_real_one
# Comma-separated list of allowed repos (e.g. owner/repo1,owner/repo2)
GITHUB_ALLOWED_REPOS=owner/repo-name
GITHUB_API_BASE=https://api.github.com
GITHUB_MAX_LOG_LINES=500

# Model Configuration
# Supports OpenAI, Google Gemini (via OpenAI compat), local Ollama, vLLM, etc.
MODEL_PROVIDER=openai
MODEL_API_BASE=https://api.openai.com/v1
MODEL_API_KEY=sk-example_api_key_replace_with_real_one
MODEL_NAME=gpt-4o-mini
MODEL_MAX_TOKENS=4096
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=3

# Processing Constraints & Limits
MAX_PATCH_SIZE_BYTES=10000
MAX_PROMPT_TOKENS=8000

# Validation Configuration (Phase 3)
VALIDATION_TIMEOUT_SECONDS=300
VALIDATION_DOCKER_IMAGE=python:3.11-slim
VALIDATION_NETWORK_DISABLED=true

# Storage & Auditing
DATABASE_PATH=./guardrail_ci.db
AUDIT_LOG_PATH=./audit.jsonl
